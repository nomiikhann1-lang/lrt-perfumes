# Vercel project settings: add these two server-only values to Preview and Production.
# Reuse your existing Hostinger WordPress URL and the matching LRT_API_SECRET from wp-config.php.
# Never prefix either key with NEXT_PUBLIC_. Never commit an actual .env file.
WORDPRESS_URL=
LRT_API_SECRET=

# Optional: set to your exact custom storefront origin. Otherwise VERCEL_URL is used.
NEXT_PUBLIC_SITE_URL=
CHECKOUT_ORIGIN=

# Vercel testing against your connected WooCommerce backend (real orders when enabled).
COMMERCE_ENABLED=true
SITE_INDEXING=false
ENABLE_DEMO=false
# Vercel's trusted proxy is detected automatically; leave false elsewhere.
TRUST_PROXY_IP=false
NEXT_TELEMETRY_DISABLED=1
